{
  "_doc": [
    "Global WaW -> BO2 script API relationships used by gscport.py. Nothing here names a map.",
    "core_scripts: WaW framework scripts that BO2's own _zm framework replaces. They are never ported;",
    "  a reference into one resolves to the BO2 script given (same function name), to a compat shim,",
    "  or to a reported stub. A value of null means BO2 has no counterpart script.",
    "preserved_scripts: WaW gameplay frameworks ported intact even when their name matches core_patterns;",
    "  the source map's override wins, otherwise stock WaW is used. WaW owns all perk machines and purchases.",
    "core_patterns: regexes; stock WaW scripts matching one are core too (value null).",
    "template_scripts: files of the WaW mod tools' zombie map template. Maps carry them, stock zones do not.",
    "  DLC3 code and teleporter functions are extracted recursively from the map's own template copy.",
    "function_renames: WaW function (any script or builtin) -> BO2 qualified function or builtin.",
    "source_script_functions: framework functions whose explicit script calls retain the authored WaW body, even when BO2 provides a same-named handler; native engine callbacks remain on BO2.",
    "compat_wrappers: WaW builtins routed through maps\\mp\\waw\\_waw2bo2_compat even though T6 has a builtin",
    "  of that name, because the semantics or the asset namespace differ.",
    "hud_cleanup_wrappers: resolved native HUD destructors -> guarded compatibility helpers; simple/dotted receivers become arguments so missing HUDs cannot prevent caller cleanup. Map-owned destructors remain source code.",
    "no_extract: core scripts whose functions are never extracted (framework setup/round logic BO2 owns).",
    "maps\\_loadout is deliberately NOT core: it is WaW's player appearance/loadout contract (viewmodel arms,",
    "  character bodies, start weapons). gscport ports it whole and _waw2bo2_characters drives it from BO2's",
    "  precache/give-character hooks.",
    "anim_builtins: animation builtins -> compat waw_anim_<value>, used in scripts whose WaW animtree is not available in BO2 (their %anim references become strings).",
    "extract_exceptions: function-name suffixes still extracted from no_extract scripts: gameplay callbacks such as",
    "  DLC3 extraction is unrestricted except for unsupported animation functions; its legacy suffix entries",
    "  below remain valid if a caller deliberately disables full template extraction.",
    "zombie_runtime: source speed selector contract and native spawn callback/location adaptation; preserve source bodies, not map-name speed presets.",
    "  actor_templates: native T6 actor family per WaW engine AI type (aitype self.type), appearance stays WaW's.",
    "  The dog uses TranZit's shipped dog graph (Nuketown's unshipped one lacks restart on its attack states:",
    "  measured, a dog bit once and froze) plus Nuketown's window barrier state, as an owned tree.",
    "  dog_rounds: WaW _zombiemode::main calls _zombiemode_dogs::init (dogs only when the map set level.dogs_enabled);",
    "  BO2's _zm_ai_dogs runs the rounds (same counts and first-round timing), with the source's dog spawn",
    "  selection over the spawners the map opened (level.enemy_dog_spawns) and the source dog health table.",
    "  client_notifies: the server moments _zm_ai_dogs (like WaW's) sends each clientnotify; the source map's",
    "  client fog monitors (level waittill msg; SetVolFog) run on the server there (T6 CSC has no volumetric fog).",
    "  native_sounds/native_music: BO2 dog aliases and music states -> the WaW aliases the source plays at the same",
    "  point (an owned copy of _zm_ai_dogs plays waw/<alias>); zmb_hellhound_vocals_amb (BO2 stalking) has none.",
    "library_functions: functions of third-party WaW map libraries -> compat waw_<value>, where BO2 has the native",
    "  feature the library worked around (e.g. treminaor's trem_hintstrings drew hints through a WaW menu).",
    "stock_map_policies: behaviour applied ONLY when the source is a retail WaW level (its fastfile is in the WaW",
    "  install's zone folder; --waw-stock-map). Custom maps keep their own logic. solo_quick_revive (user request",
    "  2026-10-14): BO-style solo Quick Revive (solo_cost, one self-revive life per purchase, solo_purchase_limit",
    "  purchases, BO2's own solo_hint key). Zombie health is not a policy: every map runs its source health step",
    "  (Translator.extract_round_health), wrap and dog rounds included (docs/CONVERT_THE_WHOLE_MAP.md).",
    "  waw_round_counter (user request 2026-10-14): the source round display functions replace BO2's 8-bit",
    "  setroundsplayed counter and its 255 round clamp; their HUD materials stay WaW (isolated from BO2's names).",
    "client_listener_calls: client-script calls a WaW client listener may make once gscport runs it on the server",
    "  (client_fx_listeners). Keyed by lower-case name. {} keeps the call; client_arg drops the local client",
    "  number at that argument index; to renames it (waw_* names live in the compat runtime); skip=true means",
    "  another translation owns listeners using it (setvolfog: client_fog_monitors), so they are not reported.",
    "  A listener calling anything else stays on the client side, unported and reported."
  ],
  "source_driven": {
    "maps\\_zombiemode": {
      "doc": "WaW drives the rounds (docs/CONVERT_THE_WHOLE_MAP.md): calls into this script run the map's own function. glue: functions that stay BO2's because the T6 engine or BO2's player/AI plumbing owns that job; each needs a reason.",
      "glue": {
        "spectators_respawn": "T6 player respawn: WaW calls the SP level.spawnPlayer; BO2's gametype owns spawning",
        "spectator_respawn": "T6 player respawn (gametype spawn path)",
        "spawnspectator": "T6 spectator state is the gametype's",
        "store_crumb": "feeds BO2's zombie pathing (the actors are BO2's)",
        "round_spawn_failsafe": "BO2 actors: BO2's failsafe knows their state",
        "round_spawning": "T6 actors spawn through BO2's spawner; its rules come from the source hooks (count, health, spawner choice)",
        "end_game": "T6 game over and its LUI screens",
        "player_damage_override": "T6 damage callback",
        "main": "the map entry; BO2's gametype starts the game"
      }
    },
    "maps\\_zombiemode_utility": {
      "doc": "only: the map's calls into these run WaW's function; BO2's same-named _zm_audio one plays BO2's lines (the map threads the kill-streak quote timer on every player)",
      "only": ["player_killstreak_timer"]
    }
  },
  "quote_triggers": {
    "doc": "WaW player quotes started from framework code BO2 replaces, ported where BO2 raises the same event (docs/MAP_CONTENT_AUDIT.md)",
    "replace": [
      {"script": "maps\\_zombiemode_spawner", "function": "play_death_vo",
       "native": "maps\\mp\\zombies\\_zm_audio::player_zombie_kill_vox"},
      {"script": "maps\\_zombiemode_powerups", "function": "powerup_vo",
       "native": "maps\\mp\\zombies\\_zm_powerups::powerup_vo"}
    ],
    "death_event": {"script": "maps\\_zombiemode_spawner", "function": "zombie_death_event"},
    "ammo": {"script": "maps\\_zombiemode", "function": "track_players_ammo_count"}
  },
  "audio_remaster": {
    "doc": "BO2's power-up grab calls leaderdialog( powerup_name ); the map's power-up script names WaW's line per power-up (gscport.Translator.announcer_hook, audioremaster)",
    "powerup_announcer": {"script": "maps\\_zombiemode_powerups", "function": "powerup_grab"},
    "announcer_alias_prefix": "waw_"
  },
  "map_content": {
    "doc": "Map content a replaced WaW framework script names, carried onto the BO2 system that replaces it (docs/MAP_CONTENT_AUDIT.md)",
    "powerup_models": {"script": "maps\\_zombiemode_powerups", "register": "add_zombie_powerup"},
    "sound_table": {"script": "maps\\_zombiemode", "register": "add_sound"}
  },
  "stock_map_policies": {
    "solo_quick_revive": {"perk": "specialty_quickrevive", "solo_cost": 500, "solo_purchase_limit": 3,
                          "solo_hint": "ZOMBIE_PERK_QUICKREVIVE_SOLO"},
    "waw_round_counter": {"round_start": "chalk_one_up", "round_end": "chalk_round_hint",
                          "state_init": "round_start", "precache_functions": ["precache_shaders", "init", "main"]}
  },
  "tesla_runtime": {
    "source_script": "maps\\_zombiemode_tesla",
    "initialize": "init",
    "damage_predicate": "is_tesla_damage",
    "damage_entry": "tesla_damage_init",
    "native_register": "maps\\mp\\zombies\\_zm_spawner::register_zombie_damage_callback",
    "max_targets": 10
  },
  "zombie_runtime": {
    "actor_templates": {"human": "zm_nuked_basic_01",
                        "dog": {"aitype": "zombie_dog", "owned_tree": "waw2bo2_dog_actor",
                                "add_states": {"zm_nuked_dog": ["zm_traverse_barrier"]}}},
    "actor_glue": {"maps\\_zombiemode_dogs::dog_init": "maps\\mp\\waw\\_waw2bo2_ai_dogs::waw2bo2_dog_actor_glue"},
    "dog_rounds": {"source_driven": true,
                   "source_script": "maps\\_zombiemode_dogs", "source_init": "init", "guard": "dogs_enabled",
                   "native_script": "maps\\mp\\zombies\\_zm_ai_dogs", "native_init": "init",
                   "source_spawning": "dog_round_spawning",
                   "spawn_logic": ["dog_spawn_sumpf_logic"], "health": "dog_health_increase",
                   "client_notifies": {"dog_start": [["dog_round_starting", 0]],
                                       "dog_stop": [["last_dog_down", 2], ["dog_round_ending", 0]]},
                   "owned_script": "maps\\mp\\waw\\_waw2bo2_ai_dogs",
                   "native_sounds": {"zmb_hellhound_prespawn": "pre_spawn", "zmb_hellhound_bolt": "bolt",
                                     "zmb_hellhound_spawn": "spawn", "zmb_dog_round_start": "dog_round_start",
                                     "vox_zmba_event_dogstart_0": "ann_vox_dog_start",
                                     "zmb_hellhound_loop_breath": "dog_trail_fire_breath",
                                     "zmb_hellhound_loop_fire": "dog_trail_fire",
                                     "zmb_hellhound_vocals_death": "zombie_dog_death",
                                     "zmb_hellhound_explode": "zombie_dog_death",
                                     "zmb_hellhound_vocals_close": "zdog_close"},
                   "native_music": {"dog_start": "dark_sting", "dog_end": "bright_sting"}},
    "source_chase": {"script": "maps\\_zombiemode_spawner", "function": "zombie_think", "rise_event": "risen", "chase_function": "find_flesh", "setup_function": "zombie_setup_attack_properties"},
    "source_selection": {"script": "maps\\_zombiemode", "function": "round_spawning", "array_field": "enemy_spawns", "candidate": "spawn_point", "previous": "old_spawn"},
    "source_membership": {"initializer": "main", "riser_array_field": "zombie_rise_spawners", "riser_actor_value": "riser", "native_riser_location": "riser_location", "source_chaser_value": "zombie_chaser", "native_chaser_value": "find_flesh"},
    "source_respawn": {"script": "maps\\_zombiemode", "function": "check_for_valid_spawn_near_team", "native_callback": "check_for_valid_spawn_near_team_callback", "native_exclusion_tag": "waw_source_respawn"},
    "source_movement": {"script": "maps\\_zombiemode", "function": "init_standard_zombie_anims", "field": "scr_anim", "row": "zombie", "states": {"walk": "zm_move_walk", "run": "zm_move_run", "sprint": "zm_move_sprint"}, "variant_script": "maps\\_zombiemode_spawner", "variant_function": "set_run_anim"},
    "source_last_zombie": {"script": "maps\\_zombiemode", "function": "round_spawning", "anim_function": "set_run_anim", "native_callback": "zombie_speed_up"},
    "source_speed": {"script": "maps\\_zombiemode_spawner", "function": "set_run_speed", "arguments": 0, "receiver": "zombie", "result_field": "zombie_move_speed", "owned_result_field": "waw_zombie_move_speed"},
    "source_round_state": {"script": "maps\\_zombiemode", "start_function": "round_spawning", "end_function": "round_think"},
    "native_spawner": "maps\\mp\\zombies\\_zm_spawner",
    "owned_spawner": "maps\\mp\\waw\\_waw2bo2_spawner",
    "native_round_runtime": "maps\\mp\\zombies\\_zm",
    "owned_round_runtime": "maps\\mp\\waw\\_waw2bo2_zm",
    "native_spawn_init": "zombie_spawn_init",
    "native_speed_init": "init_zombie_run_cycle",
    "native_movement": {"script": "maps\\mp\\animscripts\\zm_run", "function": "setanimstatefromspeed", "callback": "setanimstatefromspeed"},
    "native_location_function": "do_zombie_spawn",
    "plain_spawn_location": "spawn_location"
  },
