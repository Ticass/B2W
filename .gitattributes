src/waw2bo2/compat/menu_layers.lua text eol=lf
src/waw2bo2/compat/menu_layers.luac binary
src/waw2bo2/compat/menu_preview.lua text eol=lf
src/waw2bo2/compat/menu_preview.luac binary
src/waw2bo2/compat/waw_*.lua text eol=lf
src/waw2bo2/compat/waw_*.luac binary
tests/waw_hud_runtime.lua text eol=lf
# git apply reads blank context lines as " "; a CRLF checkout (Windows CI)
# turns them into "\r" and the patch is corrupt.
vendor/*.patch text eol=lf
