    // Per-model collision triangles (XModelCollSurf_s / XModelCollTri_s; the
    // layout is identical in T4 and T6). The bone is stored by name because the
    // bone order of a model rebuilt from GLTF can differ. waw2bo2 addition.
    class JsonXModelCollTri
    {
    public:
        std::vector<float> plane;
        std::vector<float> svec;
        std::vector<float> tvec;
    };

    NLOHMANN_DEFINE_TYPE_EXTENSION(JsonXModelCollTri, plane, svec, tvec);

    class JsonXModelCollSurf
    {
    public:
        std::vector<JsonXModelCollTri> tris;
        std::vector<float> mins;
        std::vector<float> maxs;
        std::string bone;
        int contents;
        int surfFlags;
    };

    NLOHMANN_DEFINE_TYPE_EXTENSION(JsonXModelCollSurf, tris, mins, maxs, bone, contents, surfFlags);

